generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Todo {
  id          BigInt   @id @default(autoincrement())
  name        String
  is_complete Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz

  @@map("todos")
}
