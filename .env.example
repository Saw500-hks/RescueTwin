# ==============================================================================
# RescueTwin Root Environment Configuration
# ==============================================================================

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_API_URL=http://localhost:8000
VITE_CARTO_API_KEY=

# Provider 1: Nebius Token Factory (NVIDIA Nemotron Inference)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=meta/llama-3.1-nemotron-70b-instruct

# Provider 2: NVIDIA NIM (NVIDIA Cloud Functions)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=meta/llama-3.1-nemotron-70b-instruct

# Hardware & Processing Configuration
DEVICE=cuda # Options: cuda, mps, cpu
YOLO_MODEL_PATH=yolov8n.pt
UPLOAD_DIR=/tmp/rescuetwin/uploads
RESULT_DIR=/tmp/rescuetwin/results

# Offline / Simulator Fallback:
# If no API key is provided, RescueTwin automatically engages its deterministic
# ReAct Nemotron simulator so all endpoints, tools, and UI functions run with zero friction.
