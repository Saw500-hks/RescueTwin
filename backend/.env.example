# RescueTwin Backend Environment Configuration

# Provider 1: Nebius Token Factory (NVIDIA Nemotron-4-340B-Instruct or Llama-3.1-Nemotron)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=nvidia/nemotron-4-340b-instruct

# Provider 2: NVIDIA NIM API (meta/llama-3.1-nemotron-70b-instruct)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-nemotron-70b-instruct

# Fallback: If no API key is provided, RescueTwin automatically activates its
# deterministic Nemotron ReAct Autonomous Reasoning Engine with zero configuration.
